__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated artifacts. The curated results/ snapshot is committed via `git add -f`
# (results/runs/*.json + results/figures/*). These patterns stop transient *re-runs*
# from being committed by accident; use `git add -f` to update the committed snapshot.
data/synthetic/*.txt
data/normalized/*.txt
results/runs/*.json
results/figures/*.png
results/figures/summary.csv

# keep the dir scaffolding
!**/.gitkeep

# Local (non-canonical) Ollama benchmark sweeps
results/ollama/
