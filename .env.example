# Copy to .env (or just export these) to configure the runtime.
# These are the ONLY variables read by the code (see agents/config.py).

# --- Server / model ------------------------------------------------------
# OpenAI-compatible vLLM endpoint. Defaults target a local server on :8001
# (real vLLM via scripts/launch_vllm_8b.sh, or the offline mock via
# scripts/mock_vllm_server.py).
VLLM_BASE_URL=http://localhost:8001
# Prometheus /metrics endpoint. Defaults to ${VLLM_BASE_URL}/metrics.
VLLM_METRICS_URL=http://localhost:8001/metrics
# Model name sent in each request (must match what the server serves).
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
# API key. NOTE: currently read into config.API_KEY but NOT yet sent as an
# Authorization header by the client (see TODO-1). Reserved for secured endpoints.
VLLM_API_KEY=EMPTY

# --- Networking ----------------------------------------------------------
REQUEST_TIMEOUT_S=600       # per-request HTTP timeout (seconds)
MAX_RETRIES=3               # agent call attempts before giving up

# --- Reflection / self-correction ---------------------------------------
MAX_REVISIONS=2             # bounded reviewer->workers revision rounds

# HF token for gated meta-llama weights (real hardware only; used by the
# vLLM server process, not by this client).
# HF_TOKEN=hf_xxx
